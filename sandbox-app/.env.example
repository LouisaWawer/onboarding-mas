# Kopieren nach .env (wird von .gitignore über das bestehende ".env"-Muster
# im Root-.gitignore geschützt, siehe Setup_Dokumentation.md Abschnitt 6) und
# echte Werte eintragen - dieses Beispiel enthält bewusst keinen echten Code.

# Muss exakt STUDY_ACCESS_CODE aus backend/.env entsprechen (ein fester Code
# für die ganze Studie, siehe api/config.py: access_code_is_valid()).
VITE_ACCESS_CODE=

# Nur nötig, wenn das Backend nicht unter dem Standard-Port läuft.
VITE_API_BASE_URL=http://127.0.0.1:8000
